# Copy this file to .env for local development.
# Generate each secret independently with: openssl rand -base64 32
# Never reuse these values or commit the populated .env file.
NODE_ENV=development

# Human session authentication. Use `open` for public signup or `closed` for operator-created users.
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://localhost:3000
AUTH_REGISTRATION_MODE=closed
KNOWNPATH_PUBLIC_WEB_URL=http://localhost:3000
AUTH_DEVICE_CODE_EXPIRES_SECONDS=600
AUTH_DEVICE_POLL_INTERVAL_SECONDS=5
AUTH_MACHINE_CREDENTIAL_TTL_DAYS=180

# Pepper for one-way API-key HMAC digests. This must differ from BETTER_AUTH_SECRET.
API_KEY_PEPPER=
API_KEY_LAST_USED_WRITE_INTERVAL_SECONDS=300

# This URI targets the unauthenticated development-only MongoDB container in compose.yaml.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=knownpath
MONGODB_APP_NAME=knownpath

# Connection-pool and discovery bounds. Tune these per deployed process and workload.
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# BullMQ 6.2.0 uses Valkey only for queues, schedules, retries, rate limits, locks, and ephemeral
# coordination. MongoDB remains the product source of truth. Workers always require it. Production
# API startup also requires it for distributed rate limiting; only explicit local development may
# use the in-memory limiter.
QUEUE_REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=knownpath
QUEUE_SCHEDULES_ENABLED=false
# Bounded `pnpm jobs drain` settings for scheduled/serverless worker compute. Delayed jobs do not
# prevent an idle exit; they become runnable during a later invocation.
QUEUE_DRAIN_IDLE_MS=30000
QUEUE_DRAIN_MAX_RUNTIME_MS=720000
QUEUE_DRAIN_POLL_MS=1000
QUEUE_PRODUCER_CONNECT_TIMEOUT_MS=5000
QUEUE_WORKER_HEARTBEAT_MS=15000
QUEUE_WORKER_STALE_MS=60000
QUEUE_WORKER_SHUTDOWN_MS=30000
QUEUE_WORKER_LOCK_MS=120000
QUEUE_MAX_STALLED_COUNT=2
QUEUE_CONTROL_CONCURRENCY=1
QUEUE_GITHUB_CONCURRENCY=1
QUEUE_SOURCE_CONCURRENCY=2
QUEUE_AI_CONCURRENCY=1
QUEUE_KNOWLEDGE_CONCURRENCY=2
QUEUE_FEEDBACK_CONCURRENCY=2
QUEUE_GITHUB_RATE_MAX=30
QUEUE_GITHUB_RATE_DURATION_MS=60000
QUEUE_SOURCE_RATE_MAX=60
QUEUE_SOURCE_RATE_DURATION_MS=60000
QUEUE_AI_RATE_MAX=10
QUEUE_AI_RATE_DURATION_MS=60000
QUEUE_COMPLETED_RETENTION_SECONDS=86400
QUEUE_COMPLETED_RETENTION_COUNT=1000
QUEUE_FAILED_RETENTION_SECONDS=2592000
QUEUE_FAILED_RETENTION_COUNT=10000

# API bind settings. Use 0.0.0.0 only when the API must be reachable outside this machine.
# Hosting platforms may supply PORT; when present it takes precedence over API_PORT.
API_HOST=127.0.0.1
API_PORT=3001
PORT=

# Browser origins allowed to send credentialed requests. Leave empty to disable CORS.
API_CORS_ORIGINS=http://localhost:3000

# Never use "true" here. Use false or comma-separated trusted proxy addresses/CIDR ranges.
API_TRUST_PROXY=false

# Swagger UI and request/resource bounds. Production must use `valkey`; `memory` is accepted only
# when explicitly selected for local development and never silently becomes a production fallback.
API_DOCS_ENABLED=true
API_BODY_LIMIT_BYTES=65536
API_CONNECTION_TIMEOUT_MS=10000
API_KEEP_ALIVE_TIMEOUT_MS=72000
API_MAX_PARAM_LENGTH=512
API_REQUEST_TIMEOUT_MS=30000
API_RATE_LIMIT_STORE=memory
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# Provider-neutral OpenTelemetry. `none` keeps export disabled. Use `console` for bounded local
# inspection or `otlp` with an operator-controlled collector/backend. Never place credentials in
# endpoints or telemetry resource attributes.
OTEL_ENABLED=false
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
OTEL_SERVICE_NAME=knownpath-api
OTEL_SERVICE_VERSION=development

# Supported values: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Optional GitHub API authentication. Leave empty for public REST collection at the lower
# unauthenticated rate limit. A token is required for Discussions through GitHub GraphQL.
# Fine-grained tokens need no repository permission for public-repository metadata.
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
GITHUB_USER_AGENT=knownpath/development
SOURCE_REGISTRY_PATH=config/sources/registry.json

# Incremental collection deliberately overlaps its last cursor to catch edits. Immutable content
# hashes make overlap safe. Rate-limit waits are bounded; longer waits fail for a later rerun.
GITHUB_INCREMENTAL_OVERLAP_HOURS=24
GITHUB_MAX_RATE_LIMIT_WAIT_SECONDS=120
GITHUB_REQUEST_TIMEOUT_MS=30000

# Official documentation/feed collection uses only public HTTPS endpoints and needs no credential.
# These values bound redirects, retries, response time, and decoded response size.
SOURCE_USER_AGENT=knownpath/development
SOURCE_REQUEST_TIMEOUT_MS=30000
SOURCE_MAX_RESPONSE_BYTES=5000000
SOURCE_MAX_RETRIES=3

# AI extraction. The configured development path is intentionally public-only.
# Never put private/team source data through an unpaid/public-data Gemini account.
AI_PROVIDER=gemini
AI_DATA_HANDLING=public_only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=3
GEMINI_MIN_REQUEST_SPACING_MS=1000
GEMINI_MAX_OUTPUT_TOKENS=8192

# Per-command safety budgets. Processing stops before a new call would exceed the estimated
# input budget, provider-call count, or configured target count. Actual token usage is also tracked.
AI_MAX_TARGETS=10
AI_MAX_PROVIDER_CALLS=20
AI_MAX_ESTIMATED_INPUT_TOKENS=250000
AI_MAX_ACTUAL_TOTAL_TOKENS=300000

# Candidate semantic comparison. Deterministic blocking runs first and creates no vector index;
# and semantic similarity can never authorize an automatic merge by itself. This public/unpaid
# Gemini path hard-rejects private/team candidates and referenced source records before any request.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_MODEL_VERSION=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_PROVIDER_CALLS=20
EMBEDDING_MIN_REQUEST_SPACING_MS=1000

# Retrieval. Local is the free/default path and uses MongoDB text plus deterministic
# metadata/error matching. Atlas enables explicit MongoDB Search and Vector Search indexes.
SEARCH_BACKEND=local
SEARCH_ATLAS_LEXICAL_INDEX=knownpath_lexical_v1
SEARCH_ATLAS_VECTOR_INDEX=knownpath_vector_v1
SEARCH_DEFAULT_LIMIT=10
SEARCH_MINIMUM_SCORE=35
SEARCH_CANDIDATE_POOL_MULTIPLIER=20
SEARCH_INDEX_READY_TIMEOUT_MS=120000

# The web dashboard needs the server-side API origin. For the published CLI, the same variables are
# advanced/backward-compatible overrides; normal hosted installs use browser authorization and the
# native OS credential store without environment setup.
KNOWNPATH_API_URL=
KNOWNPATH_API_KEY=
KNOWNPATH_MCP_REQUEST_TIMEOUT_MS=30000
KNOWNPATH_MCP_MAX_RESPONSE_BYTES=262144
