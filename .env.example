# Copy this file to .env for local development.
# Generate each secret independently with: openssl rand -base64 32
# Never reuse these values or commit the populated .env file.
NODE_ENV=development

# Human session authentication. Registration remains closed in Phase 3.
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://localhost:3000

# Pepper for one-way API-key HMAC digests. This must differ from BETTER_AUTH_SECRET.
API_KEY_PEPPER=
API_KEY_LAST_USED_WRITE_INTERVAL_SECONDS=300

# This URI targets the unauthenticated development-only MongoDB container in compose.yaml.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=knownpath
MONGODB_APP_NAME=knownpath

# Connection-pool and discovery bounds. Tune these per deployed process and workload.
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# API bind settings. Use 0.0.0.0 only when the API must be reachable outside this machine.
# Hosting platforms may supply PORT; when present it takes precedence over API_PORT.
API_HOST=127.0.0.1
API_PORT=3001
PORT=

# Browser origins allowed to send credentialed requests. Leave empty to disable CORS.
API_CORS_ORIGINS=http://localhost:3000

# Never use "true" here. Use false or comma-separated trusted proxy addresses/CIDR ranges.
API_TRUST_PROXY=false

# Swagger UI exposure and the Phase 3 per-process limiter. Distributed limiting is deferred.
API_DOCS_ENABLED=true
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# Supported values: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Optional GitHub API authentication. Leave empty for public REST collection at the lower
# unauthenticated rate limit. A token is required for Discussions through GitHub GraphQL.
# Fine-grained tokens need no repository permission for public-repository metadata.
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
GITHUB_USER_AGENT=knownpath/0.0.0
SOURCE_REGISTRY_PATH=config/sources/registry.json

# Incremental collection deliberately overlaps its last cursor to catch edits. Immutable content
# hashes make overlap safe. Rate-limit waits are bounded; longer waits fail for a later rerun.
GITHUB_INCREMENTAL_OVERLAP_HOURS=24
GITHUB_MAX_RATE_LIMIT_WAIT_SECONDS=120
GITHUB_REQUEST_TIMEOUT_MS=30000

# Official documentation/feed collection uses only public HTTPS endpoints and needs no credential.
# These values bound redirects, retries, response time, and decoded response size.
SOURCE_USER_AGENT=knownpath/0.0.0
SOURCE_REQUEST_TIMEOUT_MS=30000
SOURCE_MAX_RESPONSE_BYTES=5000000
SOURCE_MAX_RETRIES=3

# Phase 6 AI extraction. The configured development path is intentionally public-only.
# Never put private/team source data through an unpaid/public-data Gemini account.
AI_PROVIDER=gemini
AI_DATA_HANDLING=public_only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=3
GEMINI_MIN_REQUEST_SPACING_MS=1000
GEMINI_MAX_OUTPUT_TOKENS=8192

# Per-command safety budgets. Processing stops before a new call would exceed the estimated
# input budget, provider-call count, or configured target count. Actual token usage is also tracked.
AI_MAX_TARGETS=10
AI_MAX_PROVIDER_CALLS=20
AI_MAX_ESTIMATED_INPUT_TOKENS=250000
AI_MAX_ACTUAL_TOTAL_TOKENS=300000

# Phase 8 semantic support. Deterministic blocking always runs first, no vector index is created,
# and semantic similarity can never authorize an automatic merge by itself. This public/unpaid
# Gemini path hard-rejects private/team candidates and referenced source records before any request.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_MODEL_VERSION=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_PROVIDER_CALLS=20
EMBEDDING_MIN_REQUEST_SPACING_MS=1000

# Phase 9 retrieval. Local is the free/default path and uses MongoDB text plus deterministic
# metadata/error matching. Atlas enables explicit MongoDB Search and Vector Search indexes.
SEARCH_BACKEND=local
SEARCH_ATLAS_LEXICAL_INDEX=knownpath_lexical_v1
SEARCH_ATLAS_VECTOR_INDEX=knownpath_vector_v1
SEARCH_DEFAULT_LIMIT=10
SEARCH_MINIMUM_SCORE=35
SEARCH_CANDIDATE_POOL_MULTIPLIER=20
SEARCH_INDEX_READY_TIMEOUT_MS=120000

# Phase 11 local stdio MCP bridge. The bridge calls the backend API and never connects to MongoDB
# or Gemini. Use an active API key with knowledge:read. Do not commit the populated key.
KNOWNPATH_API_URL=
KNOWNPATH_API_KEY=
KNOWNPATH_MCP_REQUEST_TIMEOUT_MS=30000
KNOWNPATH_MCP_MAX_RESPONSE_BYTES=262144
