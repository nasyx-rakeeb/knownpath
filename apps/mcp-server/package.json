{
  "name": "@knownpath/mcp-server",
  "version": "0.4.0",
  "private": true,
  "description": "KnownPath Model Context Protocol server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "inspect": "tsx --env-file-if-exists=../../.env src/inspect.ts",
    "lint": "eslint src",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@knownpath/config": "workspace:*",
    "@knownpath/mcp": "workspace:*",
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
