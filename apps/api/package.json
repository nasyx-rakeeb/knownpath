{
  "name": "@knownpath/api",
  "version": "0.0.0",
  "private": true,
  "description": "KnownPath HTTP API.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "lint": "eslint src",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@knownpath/auth": "workspace:*",
    "@knownpath/config": "workspace:*",
    "@knownpath/contributions": "workspace:*",
    "@knownpath/database": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "@knownpath/mcp": "workspace:*",
    "@knownpath/outcomes": "workspace:*",
    "@knownpath/search": "workspace:*",
    "@modelcontextprotocol/node": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
