{
  "name": "@knownpath/worker",
  "version": "0.0.0",
  "private": true,
  "description": "KnownPath background processing runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "canonicalize": "tsx --env-file-if-exists=../../.env src/index.ts canonicalize",
    "contributions": "tsx --env-file-if-exists=../../.env src/index.ts contributions",
    "outcomes": "tsx --env-file-if-exists=../../.env src/index.ts outcomes",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "extract": "tsx --env-file-if-exists=../../.env src/index.ts extract",
    "ingest:github": "tsx --env-file-if-exists=../../.env src/index.ts github",
    "ingest:sources": "tsx --env-file-if-exists=../../.env src/index.ts sources",
    "jobs": "tsx --env-file-if-exists=../../.env src/index.ts jobs",
    "score": "tsx --env-file-if-exists=../../.env src/index.ts score",
    "retrieve": "tsx --env-file-if-exists=../../.env src/index.ts search",
    "lint": "eslint src",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@knownpath/ai": "workspace:*",
    "@knownpath/canonicalization": "workspace:*",
    "@knownpath/config": "workspace:*",
    "@knownpath/contributions": "workspace:*",
    "@knownpath/database": "workspace:*",
    "@knownpath/github-ingestion": "workspace:*",
    "@knownpath/outcomes": "workspace:*",
    "@knownpath/jobs": "workspace:*",
    "@knownpath/pipelines": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "@knownpath/source-ingestion": "workspace:*",
    "@knownpath/search": "workspace:*",
    "@knownpath/verification": "workspace:*"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
