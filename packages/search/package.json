{
  "name": "@knownpath/search",
  "version": "0.0.0",
  "private": true,
  "description": "Search and retrieval boundary for KnownPath.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@google/genai": "catalog:",
    "@knownpath/database": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "semver": "catalog:",
    "zod": "catalog:"
  }
}
