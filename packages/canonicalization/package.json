{
  "name": "@knownpath/canonicalization",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic candidate deduplication and canonical KnownPath lifecycle.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@knownpath/database": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "@knownpath/search": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
