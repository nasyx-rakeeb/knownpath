{
  "name": "@knownpath/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable authentication, API-key, authorization, and audit services for KnownPath.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "auth:user:create": "tsx src/cli/create-user.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "catalog:",
    "@knownpath/config": "workspace:*",
    "@knownpath/database": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
