{
  "name": "@knownpath/contributions",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-safe agent contribution sanitization and processing for KnownPath.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@knownpath/canonicalization": "workspace:*",
    "@knownpath/database": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "@knownpath/observability": "workspace:*",
    "@knownpath/verification": "workspace:*",
    "@secretlint/core": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
