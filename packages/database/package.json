{
  "name": "@knownpath/database",
  "version": "0.0.0",
  "private": true,
  "description": "MongoDB persistence and repository boundary for KnownPath.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:init": "tsx src/cli/initialize.ts",
    "db:inspect": "tsx src/cli/inspect.ts",
    "db:verify": "tsx src/cli/verify.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@knownpath/config": "workspace:*",
    "@knownpath/domain": "workspace:*",
    "mongodb": "catalog:"
  },
  "devDependencies": {
    "@knownpath/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
