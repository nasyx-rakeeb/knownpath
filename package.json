{
  "name": "knownpath-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Shared technical knowledge infrastructure for AI coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "auth:user:create": "pnpm --filter @knownpath/auth auth:user:create",
    "build": "turbo run build",
    "canonicalize": "pnpm --filter @knownpath/worker canonicalize",
    "contributions": "pnpm --filter @knownpath/worker contributions",
    "outcomes": "pnpm --filter @knownpath/worker outcomes",
    "db:init": "pnpm --filter @knownpath/database db:init",
    "db:inspect": "pnpm --filter @knownpath/database db:inspect",
    "db:verify": "pnpm --filter @knownpath/database db:verify",
    "dev": "turbo run dev",
    "dev:infra": "docker compose up -d valkey",
    "dev:infra:all": "docker compose up -d mongodb valkey",
    "dev:infra:local-mongo": "docker compose up -d mongodb",
    "dev:infra:down": "docker compose down",
    "dev:stack": "docker compose --profile platform up --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "pnpm --filter @knownpath/worker extract",
    "ingest:github": "pnpm --filter @knownpath/worker ingest:github",
    "ingest:sources": "pnpm --filter @knownpath/worker ingest:sources",
    "lint": "turbo run lint",
    "mcp:stdio": "pnpm --filter @knownpath/mcp-server start",
    "mcp:inspect": "pnpm --filter @knownpath/mcp-server inspect",
    "knownpath": "pnpm --filter ./apps/cli start",
    "jobs": "pnpm --filter @knownpath/worker jobs",
    "package:validate": "node scripts/validate-cli-package.mjs",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "score": "pnpm --filter @knownpath/worker score",
    "search": "pnpm --filter @knownpath/worker run retrieve",
    "security:audit": "pnpm audit --audit-level high",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
