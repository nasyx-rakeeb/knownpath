{
  "name": "knownpath",
  "version": "0.0.0",
  "private": true,
  "description": "Shared technical knowledge infrastructure for AI coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "db:init": "pnpm --filter @knownpath/database db:init",
    "db:inspect": "pnpm --filter @knownpath/database db:inspect",
    "db:verify": "pnpm --filter @knownpath/database db:verify",
    "dev": "turbo run dev",
    "dev:infra": "docker compose up -d mongodb",
    "dev:infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
